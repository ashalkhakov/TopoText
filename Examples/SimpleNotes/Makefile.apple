# SimpleNotes on macOS without Xcode's project: the server and the tests,
# with clang, Xcode's momc and xctest, over TopoText's libraries (make at
# the root) and ODataKit's frameworks (make odatakit there). The apps are
# the Xcode project's (TopoText.xcworkspace).
#
#   make            build/simplenotes-server (and SimpleNotes.momd beside it)
#   make test       the tests
#   make check      the tests, and two devices against the server over HTTP

ROOT = ../..
BUILD ?= build
ODATAKIT_FRAMEWORKS ?= $(firstword $(wildcard $(ROOT)/build/ODataKit/Build/Products/Debug))
TOPOTEXT_BUILD = $(abspath $(ROOT)/build)
CC = clang
FLAGS = -fobjc-arc -fblocks -g -Wall -Wextra -Wno-unused-parameter -mmacosx-version-min=14.0
INC = -IShared -I$(GENERATED) -I$(ROOT)/Sources/TopoText/include -I$(ROOT)/Sources/TopoTextSync/include -F$(ODATAKIT_FRAMEWORKS)
LIBS = -L$(TOPOTEXT_BUILD) -lTopoTextSync -lTopoText -Wl,-rpath,$(TOPOTEXT_BUILD) \
	-F$(ODATAKIT_FRAMEWORKS) -Wl,-rpath,$(abspath $(ODATAKIT_FRAMEWORKS)) \
	-framework ODataSync -framework ODataService -framework HTTPServerKit -framework ODataIncrementalStore \
	-framework OTelKit -framework ODataKit -framework CoreData -framework Foundation
# The model's classes' properties, generated as Xcode generates them.
GENERATED = $(BUILD)/Generated
MODEL = Shared/SNModel.m Shared/SNNote.m Shared/SNFolder.m Shared/SNAttachment.m Shared/SNMigration.m \
	$(GENERATED)/SNNote+CoreDataProperties.m $(GENERATED)/SNFolder+CoreDataProperties.m $(GENERATED)/SNAttachment+CoreDataProperties.m
# The model's files, spaces escaped: Xcode names a version "SimpleNotes 2".
MODEL_FILES := $(shell find SimpleNotes.xcdatamodeld -type f | sed 's/ /\\ /g')
SHARED = $(MODEL) Shared/SNNotes.m Shared/SNResolver.m Shared/SNRichText.m
DEVELOPER := $(shell xcode-select -p)
XCTEST_FRAMEWORKS = $(DEVELOPER)/Platforms/MacOSX.platform/Developer/Library/Frameworks
XCTEST_LIBS = $(DEVELOPER)/Platforms/MacOSX.platform/Developer/usr/lib

.PHONY: all test check clean libraries
all: $(BUILD)/simplenotes-server $(BUILD)/SimpleNotes.momd

libraries:
	@test -n "$(ODATAKIT_FRAMEWORKS)" || { echo "no ODataKit frameworks: make odatakit at the root"; exit 1; }
	$(MAKE) -C $(ROOT) -f Makefile.apple

$(BUILD)/SimpleNotes.momd: $(MODEL_FILES)
	@mkdir -p $(BUILD)
	rm -rf $@ && xcrun momc SimpleNotes.xcdatamodeld $(abspath $@) >/dev/null

$(GENERATED)/SNNote+CoreDataProperties.m $(GENERATED)/SNFolder+CoreDataProperties.m $(GENERATED)/SNAttachment+CoreDataProperties.m: $(MODEL_FILES)
	rm -rf $(GENERATED) && mkdir -p $(GENERATED)
	xcrun momc --action generate SimpleNotes.xcdatamodeld $(abspath $(GENERATED)) >/dev/null

$(BUILD)/simplenotes-server: Server/SNServer.m $(MODEL) libraries
	@mkdir -p $(BUILD)
	$(CC) $(FLAGS) $(INC) Server/SNServer.m $(MODEL) $(LIBS) -o $@

$(BUILD)/sn-check: Tests/sn-check.m Shared/SNCheck.m $(MODEL) Shared/SNNotes.m Shared/SNResolver.m libraries
	$(CC) $(FLAGS) $(INC) Tests/sn-check.m Shared/SNCheck.m $(MODEL) Shared/SNNotes.m Shared/SNResolver.m $(LIBS) -o $@

$(BUILD)/SimpleNotesTests.xctest: Tests/SNNotesTests.m Tests/SNTextBindingTests.m Tests/SNMigrationTests.m $(SHARED) $(BUILD)/SimpleNotes.momd libraries
	@mkdir -p $@/Contents/MacOS $@/Contents/Resources
	rm -rf $@/Contents/Resources/SimpleNotes.momd && cp -R $(BUILD)/SimpleNotes.momd $@/Contents/Resources/
	printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict><key>CFBundleExecutable</key><string>SimpleNotesTests</string><key>CFBundleIdentifier</key><string>io.github.ashalkhakov.SimpleNotesTests</string><key>CFBundlePackageType</key><string>BNDL</string></dict></plist>\n' > $@/Contents/Info.plist
	$(CC) $(FLAGS) $(INC) -bundle Tests/SNNotesTests.m Tests/SNTextBindingTests.m Tests/SNMigrationTests.m $(SHARED) $(LIBS) -framework AppKit \
	  -F$(XCTEST_FRAMEWORKS) -framework XCTest -Wl,-rpath,$(XCTEST_FRAMEWORKS) -Wl,-rpath,$(XCTEST_LIBS) \
	  -o $@/Contents/MacOS/SimpleNotesTests

test: $(BUILD)/SimpleNotesTests.xctest
	xcrun xctest $(BUILD)/SimpleNotesTests.xctest

check: test all $(BUILD)/sn-check
	Tests/serve-and-check.sh $(BUILD)/simplenotes-server sh -c '$(BUILD)/sn-check "$$0" $(BUILD)/SimpleNotes.momd'


clean:
	rm -rf $(BUILD)
