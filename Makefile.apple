# TopoText and SimpleNotes on Apple's platforms, the familiar way
# (gnustep-release-actions' macos.yml and ios.yml run the same):
#
#   make -f Makefile.apple            the libraries (build/libTopoText.dylib,
#                                     build/libTopoTextSync.dylib), and
#                                     SimpleNotes for macOS, universal, with
#                                     its server
#   make -f Makefile.apple check      the Xcode projects as Scripts/xcodeproj.py
#                                     writes them; the libraries' suites, by
#                                     xctest, and a long convergence run;
#                                     SimpleNotes' tests, two devices through
#                                     its server (Examples/SimpleNotes)
#   make -f Makefile.apple install DESTDIR=<dir>       SimpleNotes.app
#   make -f Makefile.apple installcheck DESTDIR=<dir>  the installed app,
#                                     driven from within against its own server
#
#   make -f Makefile.apple ios        SimpleNotes for iOS: for a device
#                                     (unsigned) and for the simulator
#   make -f Makefile.apple ios-check  the libraries compiled for iOS
#   make -f Makefile.apple ios-install DESTDIR=<dir>   <dir>/iphoneos and
#                                     <dir>/iphonesimulator/SimpleNotes.app
#   make -f Makefile.apple ios-installcheck DESTDIR=<dir>  the simulator's app,
#                                     its self-test against its own server
#
# What it builds on (ODataKit's XCFrameworks, Sparkle's) is in .deps/, by
# the versions .github/pins.env names (gnustep-release-actions'
# scripts/deps.sh apple). GNUstep: GNUmakefile.

BUILD ?= build
DEPS = .deps
CC = clang
MACOS_MIN ?= 14.0
IOS_MIN ?= 15.0
WARN = -Wall -Wextra -Wno-unused-parameter
OBJCFLAGS = -fobjc-arc -fblocks -g $(WARN)
TT_INC = -ISources/TopoText/include -ISources/TopoText/include/TopoText -ISources/TopoText
SYNC_INC = -ISources/TopoTextSync/include -ISources/TopoTextSync/include/TopoTextSync
TT_SRCS = $(wildcard Sources/TopoText/*.m)
SYNC_SRCS = $(wildcard Sources/TopoTextSync/*.m)
TT_HDRS = $(wildcard Sources/TopoText/*.h Sources/TopoText/include/TopoText/*.h)
SYNC_HDRS = $(wildcard Sources/TopoTextSync/include/TopoTextSync/*.h)

# ODataKit's frameworks, each from its XCFramework's slice for a platform.
ODATAKIT = ODataKit OTelKit ODataIncrementalStore HTTPServerKit ODataService ODataSync
odatakit_flags = $(foreach f,$(ODATAKIT),-F$(DEPS)/$(f).xcframework/$(1))
ODATAKIT_FLAGS = $(call odatakit_flags,macos-arm64_x86_64) \
	$(foreach f,$(ODATAKIT),-Wl,-rpath,$(abspath $(DEPS)/$(f).xcframework/macos-arm64_x86_64))

DEVELOPER := $(shell xcode-select -p)
XCTEST_FRAMEWORKS = $(DEVELOPER)/Platforms/MacOSX.platform/Developer/Library/Frameworks
XCTEST_LIBS = $(DEVELOPER)/Platforms/MacOSX.platform/Developer/usr/lib
ABS_BUILD = $(abspath $(BUILD))

# The apps, by Xcode, from the workspace Scripts/xcodeproj.py writes.
DERIVED = $(BUILD)/DerivedData
PRODUCTS = $(DERIVED)/Build/Products
XCODEBUILD = xcodebuild -workspace TopoText.xcworkspace -derivedDataPath $(DERIVED)

.PHONY: all deps libraries test app server check install installcheck \
	ios ios-libraries ios-check ios-install ios-installcheck clean
all: libraries app

deps:
	@test -d $(DEPS)/ODataSync.xcframework \
	  || { echo "no ODataKit in $(DEPS): gnustep-release-actions' scripts/deps.sh apple fetches what .github/pins.env names"; exit 1; }

libraries: deps $(BUILD)/libTopoText.dylib $(BUILD)/libTopoTextSync.dylib

$(BUILD)/libTopoText.dylib: $(TT_SRCS) $(TT_HDRS)
	@mkdir -p $(BUILD)
	$(CC) $(OBJCFLAGS) -mmacosx-version-min=$(MACOS_MIN) $(TT_INC) -dynamiclib $(TT_SRCS) \
	  -install_name @rpath/libTopoText.dylib -framework Foundation -o $@

$(BUILD)/libTopoTextSync.dylib: $(SYNC_SRCS) $(SYNC_HDRS) $(BUILD)/libTopoText.dylib
	$(CC) $(OBJCFLAGS) -mmacosx-version-min=$(MACOS_MIN) $(TT_INC) $(SYNC_INC) $(ODATAKIT_FLAGS) -dynamiclib $(SYNC_SRCS) \
	  -install_name @rpath/libTopoTextSync.dylib -L$(BUILD) -lTopoText \
	  -framework ODataSync -framework ODataKit -framework CoreData -framework Foundation -o $@

# A test bundle: the suite's objects, an Info.plist, run by xctest.
define tt_bundle
	@mkdir -p $@/Contents/MacOS
	printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict><key>CFBundleExecutable</key><string>$(1)</string><key>CFBundleIdentifier</key><string>io.github.ashalkhakov.$(1)</string><key>CFBundlePackageType</key><string>BNDL</string><key>CFBundleName</key><string>$(1)</string></dict></plist>\n' > $@/Contents/Info.plist
endef

$(BUILD)/TopoTextTests.xctest: Tests/TopoTextTests.m Tests/TopoTextFuzzTests.m Tests/TTTableTests.m Tests/TTUndoTests.m Tests/TTCoreTests.m $(BUILD)/libTopoText.dylib
	$(call tt_bundle,TopoTextTests)
	$(CC) $(OBJCFLAGS) -mmacosx-version-min=$(MACOS_MIN) $(TT_INC) -bundle Tests/TopoTextTests.m Tests/TopoTextFuzzTests.m Tests/TTTableTests.m Tests/TTUndoTests.m Tests/TTCoreTests.m \
	  -F$(XCTEST_FRAMEWORKS) -framework XCTest -Wl,-rpath,$(XCTEST_FRAMEWORKS) -Wl,-rpath,$(XCTEST_LIBS) \
	  -L$(BUILD) -lTopoText -Wl,-rpath,$(ABS_BUILD) -framework Foundation -o $@/Contents/MacOS/TopoTextTests

$(BUILD)/TopoTextSyncTests.xctest: Tests/TopoTextSyncTests.m $(BUILD)/libTopoTextSync.dylib
	$(call tt_bundle,TopoTextSyncTests)
	$(CC) $(OBJCFLAGS) -mmacosx-version-min=$(MACOS_MIN) $(TT_INC) $(SYNC_INC) $(ODATAKIT_FLAGS) -bundle Tests/TopoTextSyncTests.m \
	  -F$(XCTEST_FRAMEWORKS) -framework XCTest -Wl,-rpath,$(XCTEST_FRAMEWORKS) -Wl,-rpath,$(XCTEST_LIBS) \
	  -L$(BUILD) -lTopoTextSync -lTopoText -Wl,-rpath,$(ABS_BUILD) \
	  -framework ODataSync -framework ODataService -framework ODataKit -framework CoreData -framework Foundation \
	  -o $@/Contents/MacOS/TopoTextSyncTests

# The libraries' suites, by xctest.
test: libraries $(BUILD)/TopoTextTests.xctest $(BUILD)/TopoTextSyncTests.xctest
	xcrun xctest $(BUILD)/TopoTextTests.xctest
	xcrun xctest $(BUILD)/TopoTextSyncTests.xctest

app: deps
	$(XCODEBUILD) -scheme SimpleNotes -configuration Release -destination 'generic/platform=macOS' build
	@for fw in TopoText TopoTextSync ODataKit ODataSync Sparkle; do \
	  test -d $(PRODUCTS)/Release/SimpleNotes.app/Contents/Frameworks/$$fw.framework \
	    || { echo "SimpleNotes.app does not embed $$fw.framework"; exit 1; }; \
	done

# The server the apps' self-tests run against, beside the frameworks it loads.
server: deps
	$(XCODEBUILD) -scheme simplenotes-server -configuration Release -destination 'platform=macOS' build

check: all
	python3 Scripts/xcodeproj.py
	git diff --exit-code -- '*.xcodeproj' '*.xcworkspace' \
	  || { echo "check: run Scripts/xcodeproj.py and commit what it writes"; exit 1; }
	$(MAKE) -f Makefile.apple test
	TOPOTEXT_SEEDS=2000 xcrun xctest -XCTest TopoTextFuzzTests,TTTableTests/testCopiesEditedAtRandomConverge $(BUILD)/TopoTextTests.xctest
	$(MAKE) -C Examples/SimpleNotes -f Makefile.apple check

install: app
	@test -n "$(DESTDIR)" || { echo "install: give DESTDIR"; exit 1; }
	mkdir -p $(DESTDIR)
	rm -rf $(DESTDIR)/SimpleNotes.app
	ditto $(PRODUCTS)/Release/SimpleNotes.app $(DESTDIR)/SimpleNotes.app

installcheck: server
	Examples/SimpleNotes/Tests/self-test.sh $(PRODUCTS)/Release/simplenotes-server $(DESTDIR)/SimpleNotes.app/Contents/MacOS/SimpleNotes

ios: deps
	$(XCODEBUILD) -scheme SimpleNotes-iOS -configuration Release -destination 'generic/platform=iOS' \
	  CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" build
	$(XCODEBUILD) -scheme SimpleNotes-iOS -configuration Release -destination 'generic/platform=iOS Simulator' build

# iOS has no xctest to run here: the libraries compiled for a device and the
# simulator, so what does not build there is found here.
ios-libraries: deps
	@mkdir -p $(BUILD)/ios
	set -e; for sdk in iphoneos iphonesimulator; do \
	  target=arm64-apple-ios$(IOS_MIN); slice=ios-arm64; \
	  [ $$sdk = iphonesimulator ] && { target=$$target-simulator; slice=ios-arm64_x86_64-simulator; }; \
	  for f in $(TT_SRCS); do \
	    xcrun -sdk $$sdk $(CC) -target $$target $(OBJCFLAGS) $(TT_INC) -c $$f -o $(BUILD)/ios/$$sdk-$$(basename $$f .m).o; \
	  done; \
	  for f in $(SYNC_SRCS); do \
	    xcrun -sdk $$sdk $(CC) -target $$target $(OBJCFLAGS) $(TT_INC) $(SYNC_INC) \
	      $(foreach f,$(ODATAKIT),-F$(DEPS)/$(f).xcframework/$$slice) -c $$f -o $(BUILD)/ios/$$sdk-sync-$$(basename $$f .m).o; \
	  done; \
	done

ios-check: ios-libraries

ios-install: ios
	@test -n "$(DESTDIR)" || { echo "ios-install: give DESTDIR"; exit 1; }
	@for sdk in iphoneos iphonesimulator; do \
	  rm -rf $(DESTDIR)/$$sdk/SimpleNotes.app; mkdir -p $(DESTDIR)/$$sdk; \
	  ditto $(PRODUCTS)/Release-$$sdk/SimpleNotes.app $(DESTDIR)/$$sdk/SimpleNotes.app || exit 1; \
	done

ios-installcheck: server
	Examples/SimpleNotes/Tests/ios-self-test.sh $(PRODUCTS)/Release/simplenotes-server $(DESTDIR)/iphonesimulator/SimpleNotes.app

clean:
	rm -rf $(BUILD)/*.dylib $(BUILD)/*.dSYM $(BUILD)/*.xctest $(BUILD)/ios $(DERIVED)
	$(MAKE) -C Examples/SimpleNotes -f Makefile.apple clean
